{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "rootDir": "./src",
    "moduleResolution": "node",
    "declaration": true,
    "sourceMap": true,
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "strictPropertyInitialization": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "incremental": true,
    "baseUrl": "./",
    "paths": {
      "@sentinel/core": ["src/core/index.ts"],
      "@sentinel/core/*": ["src/core/*"],
      "@sentinel/types": ["src/types/index.ts"],
      "@sentinel/types/*": ["src/types/*"],
      "@sentinel/validators": ["src/validators/index.ts"],
      "@sentinel/validators/*": ["src/validators/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "src/__tests__"]

}